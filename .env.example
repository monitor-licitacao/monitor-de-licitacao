# VITE_AMPLITUDE_API_KEY: Amplitude Analytics + Session Replay (client-side, inlined at build time).
VITE_AMPLITUDE_API_KEY="YOUR_AMPLITUDE_API_KEY_HERE"

# AMPLITUDE_AI_API_KEY: Amplitude Agent Analytics (server-side, instrumenta os agentes do CRM/Gemini).
AMPLITUDE_AI_API_KEY="YOUR_AMPLITUDE_API_KEY_HERE"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# XAI_API_KEY: Fallback provider (server/lib/ai.ts) usado quando o Gemini
# falha por quota/rate-limit. Obtenha em https://console.x.ai
XAI_API_KEY="YOUR_XAI_API_KEY_HERE"

# Ollama (local) — provider preferido em server/lib/ai.ts
# API: http://127.0.0.1:11434  |  OpenAI-compatible: .../v1
# hermes3:3b NÃO suporta thinking — o client não envia think/reasoning.
OLLAMA_ENABLED=true
# Local: http://127.0.0.1:11434/v1  |  Cloud API: https://ollama.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=hermes3:3b
# Local: qualquer valor. Cloud direto (ollama.com): chave de https://ollama.com/settings/keys
# OLLAMA_API_KEY=ollama

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CERT_ENCRYPTION_KEY: Symmetric key used to encrypt the PNCP digital certificate
# passphrase (tenantConfigs.pncpConfig) before it is stored in the database.
# MUST be set to a strong random value in production.
CERT_ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION"

# MONITOR_API_KEY: header x-api-key / workers (fail-closed; required in production)
MONITOR_API_KEY="CHANGE_ME_IN_PRODUCTION"

# JWT_SECRET: Assina os tokens de sessão emitidos por POST /api/auth/login.
# Claims incluem id, name, email, tenantId. Obrigatório em produção.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# CORS_ORIGINS: comma-separated browser origins allowed in production.
# Required when NODE_ENV=production for any front-end hosted on another origin.
# Example (replace with your real domains — do not leave placeholders):
# CORS_ORIGINS="https://licitacoes.getgymsite.com.br"
# If unset in production, cross-origin browser requests are denied (fail-closed).
CORS_ORIGINS="https://licitacoes.getgymsite.com.br"
