\t\t\t\t\t\t\t\t\t\t\t<a href=\"/EditaisLicitacoes/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tLicitações e Processos Eletrônicos de Dispensa\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"/ProcessoEletronicoDispensa/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tProcesso Eletrônico de Dispensa\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t\t\t\t\t<a target=\"_blank\" href=\"https://redelog.rj.gov.br/redelog/compras-centralizadas/\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tCompras Centralizadas\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t<li class=\"sr-only\"><a href=\"#\" class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\t\t\taria-expanded=\"true\">Fechar Submenu</a></li>\n\t\t\t\t\t\t\t\t\t\t</ul></li>\n\n\t\t\t\t\t\t\t\t\t<li class=\"dropdown\"><a no-href class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\taria-expanded=\"false\"><span class=\"sr-only\">Abrir\n\t\t\t\t\t\t\t\t\t\t\t\tou Fechar SubMenu</span>Contratos</a>\n\t\t\t\t\t\t\t\t\t\t<ul class=\"dropdown-menu\">\n\t\t\t\t\t\t\t\t\t\t\t<li><a\n\t\t\t\t\t\t\t\t\t\t\t\thref=\"/Contrato/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tConsultar Contratos </a></li>\n\t\t\t\t\t\t\t\t\t\t\t<li class=\"sr-only\"><a href=\"#\" class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\t\t\taria-expanded=\"true\"> Fechar Submenu </a></li>\n\t\t\t\t\t\t\t\t\t\t</ul></li>\n\n\t\t\t\t\t\t\t\t\t<li class=\"dropdown\"><a no-href class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\taria-expanded=\"false\"><span class=\"sr-only\">Abrir\n\t\t\t\t\t\t\t\t\t\t\t\tou Fechar SubMenu</span> Fornecedores </a>\n\t\t\t\t\t\t\t\t\t\t<ul class=\"dropdown-menu\">\n\t\t\t\t\t\t\t\t\t\t\t<!-- 2nd level -->\n\t\t\t\t\t\t\t\t\t\t\t<!--with items group-->\n\n\t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t\t<li class=\"dropdown dropdown-submenu\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"/PreFornecedor/inicioRegistro.action\" class=\"dropdown-toggle\" data-toggle=\"dropdown\">\n \t\t\t\t\t\t\t\t\t\t\t\t\tRegistre-se </a>\n \t\t\t\t\t\t\t\t\t\t\t\t<ul class=\"dropdown-menu\">\n \t\t\t\t\t\t\t\t\t\t\t\t\t<li><a href=\"/PreFornecedor/primeiraEtapa.action\">\n \t\t\t\t\t\t\t\t\t\t\t\t\t\t\tRegistro no SIGA </a></li>\n \t\t\t\t\t\t\t\t\t\t\t\t\t<li><a href=\"/PreFornecedor/altereCompleteCadastro.action\">\n \t\t\t\t\t\t\t\t\t\t\t\t\t\t\tAltere ou Complete </a></li>\n \t\t\t\t\t\t\t\t\t\t\t\t</ul>\n \t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t\t<li><a\n\t\t\t\t\t\t\t\t\t\t\t\thref=\"/Fornecedor/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tConsultar Fornecedores </a></li>\n\t\t\t\t\t\t\t\t\t\t\t<li><a\n\t\t\t\t\t\t\t\t\t\t\t\thref=\"/Sancao/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tConsultar Sanções </a></li>\n\t\t\t\t\t\t\t\t\t\t\t<!-- <li> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- <a href=\"#\"> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- Fornecedor - CRC -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- </a> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- </li> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- <li> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- <a href=\"#\"> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- Consultar CRC -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- </a> -->\n\t\t\t\t\t\t\t\t\t\t\t<!-- </li> -->\n\t\t\t\t\t\t\t\t\t\t\t<li><a\n\t\t\t\t\t\t\t\t\t\t\t\thref=\"/ManualTermo/listar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tOrientações ao Fornecedor </a></li>\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t<li class=\"sr-only\"><a href=\"#\" class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\t\t\taria-expanded=\"true\"> Fechar Submenu </a></li>\n\t\t\t\t\t\t\t\t\t\t</ul></li>\n\n\n\t\t\t\t\t\t\t\t\t<li class=\"dropdown\"><a no-href class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\taria-expanded=\"false\"><span class=\"sr-only\">Abrir\n\t\t\t\t\t\t\t\t\t\t\t\tou Fechar SubMenu</span>Catálogo</a>\n\t\t\t\t\t\t\t\t\t\t<ul class=\"dropdown-menu\">\n\t\t\t\t\t\t\t\t\t\t\t<li><a\n\t\t\t\t\t\t\t\t\t\t\t\thref=\"/Catalogo/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tMateriais e Serviços </a></li>\n\t\t\t\t\t\t\t\t\t\t\t<li class=\"sr-only\"><a href=\"#\" class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\t\t\taria-expanded=\"true\"> Fechar Submenu </a></li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</li>\n\n\t\t\t\t\t\t\t\t\t<li class=\"dropdown\"><a no-href class=\"dropdown-toggle\"\n\t\t\t\t\t\t\t\t\t\tdata-toggle=\"dropdown\" role=\"button\" aria-haspopup=\"true\"\n\t\t\t\t\t\t\t\t\t\taria-expanded=\"false\"><span class=\"sr-only\">Abrir\n\t\t\t\t\t\t\t\t\t\t\t\tou Fechar SubMenu</span>Banco de Preços</a>\n\t\t\t\t\t\t\t\t\t\t<ul class=\"dropdown-menu\">\n\t\t\t\t\t\t\t\t\t\t\t<!-- 2nd level -->\n\t\t\t\t\t\t\t\t\t\t\t<li><a\n\t\t\t\t\t\t\t\t\t\t\t\thref=\"/BancoDePrecoHistorico/buscar.action\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tHistórico de Preços </a></li>\n\t\t\t\t\t\t\t\t\t\t</ul></li>\n\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</ul>\n\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t<div class=\"atalhorecolher\"> -->\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t\t<a noref class=\"btn btn-default btn-sm expandir\"><i class=\"material-icons md \">&#xE313;</i> Expandir Todos</a> -->\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t\t<a noref class=\"btn btn-default btn-sm recolher\"><i class=\"material-icons md \">&#xE316;</i> Recolher Todos</a> -->\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t\t<div> -->\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t\t\t<a href=\"#fimnavegacao\" id=\"fimnavegacao\" name=\"fimnavegacao\" class=\"sr-only\">Fim da Navegação</a> -->\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t\t</div>/.navbar-collapse -->\n\t\t\t\t\t\t\t\t<!-- \t\t\t\t\t\t\t\t\t</div> -->\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"buscaGoogle\">\n\t\t\t\t\t\t\t\t<form id=\"campoBuscaGoogle\" action=\"realizaBusca();\" onsubmit=\"return false\">\n\t\t\t\t\t\t\t\t\t<label for=\"campoBusca\" class=\"hidden\">Campo de Busca</label>\n\t\t\t\t\t\t\t\t\t<input type=\"text\" class=\"txt\" id=\"campoBusca\"> <input\n\t\t\t\t\t\t\t\t\t\ttype=\"submit\" class=\"material-icons first md\" value=\"&#xE8B6;\"\n\t\t\t\t\t\t\t\t\t\tonclick=\"realizaBusca();\">\n\t\t\t\t\t\t\t\t</form>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</nav>\n\t</header>\n\n\n\t<div class=\"row submenubottom\" style=\"display: none !important;\">\n\t\t<div class=\"col-lg-offset-1 col-md-12\">\n\t\t\t<span> <a\n\t\t\t\thref=\"/Principal/extracaoTotal.action\"\n\t\t\t\talt=\"Lista Extrações Totais\"> Lista Extrações Totais <i\n\t\t\t\t\tclass=\"material-icons\">chevron_right</i>\n\t\t\t</a>\n\t\t\t</span>\n\t\t</div>\n\t</div>\n\n\t\n\n\t<script type=\"text/javascript\">\n\t\n\tfunction ordenarCombo(combo) {\n\t\t$(\"#\" + combo).html($(\"#\" + combo + \" option\").sort(function (a, b) {\n\t\t\ta.value != \"\" ? comboIdA = parseInt(a.value) : comboIdA = 0;\n\t\t\tb.value != \"\" ? comboIdB = parseInt(b.value) : comboIdB = 0;\n\t\t    return comboIdA == comboIdB ? 0 : comboIdA < comboIdB ? -1 : 1\n\t\t}))\n\t}\n\n\t\t\n\n\t\t$(document).ready(function() {\n\t\t\t\n\t\t\t$(\"#close\").click(function(){\n\t\t\t\t$(\"#msgWarning2\").hide();\n\t\t\t});\n\t\t\t\n\t\t\t$(\"input, select\").keydown(function(e) {\n\t\t\t\t\n\t\t\t\tif (e.which == 13) {\t\t\t\t\n\t\t\t\t\tcallback();\n\t\t\t\t\te.preventDefault();\n\t\t\t\t\te.stopImmediatePropagation();\n\t\t\t\t}\n\t\t\t});\n\t\t\t\n\t\t\t\n// \t\t\t$(\"#addrowCatalogo\").click(function() {\n// \t\t        var counter = 0;\n// \t\t        $(\".show\").each(function(){\n// \t\t            counter++;\n// \t\t        });\n// \t\t        if(counter == 1){\n// \t\t        \t$(\"#linha3\").attr(\"class\", \"show\");\n// \t\t        \t$(linha3).show();\n// \t\t        }else{\n// \t\t        \t$(\"#linha2\").attr(\"class\", \"show\");\n// \t\t        \t$(linha2).show();\n// \t\t        }\n// \t\t        if (counter == 1){\n// \t\t            $('#addrowCatalogo').attr('disabled', true).html(\"<i class='material-icons'>&#xE14B;</i> Limite alcançado\");\n// \t\t        }\n// \t\t        return false;\n// \t\t    });\n// \t\t\t$(\"#removeLinha2\").click(function() {\n// \t\t\t\tremoveLinhas($(this).val())\n// \t\t\t\treturn false;\n// \t\t\t});\n\t\t\t\n// \t\t\t$(\"#removeLinha3\").click(function() {\n// \t\t\t\tremoveLinhas($(this).val())\n// \t\t\t\treturn false;\n// \t\t\t});\n\t\t\t\t\t\t\n\t\t\t$(\"#idTipo\").change(function() {\n\t\t\t\t$('#familia').find('option').remove().end().append('<option value=\"\" selected=\"selected\">Selecione</option>').val('');\n\t\t\t\t$('#classe').find('option').remove().end().append('<option value=\"\" selected=\"selected\">Selecione a Família</option>').val('');\n\t\t\t\t$('#artigo').find('option').remove().end().append('<option value=\"\" selected=\"selected\">Selecione a Classe</option>').val('');\n\t\t\t\n\t\t\tif ($(this).val() != \"\") {\n\t\t\t\tvar idTipo = $(\"#idTipo\").val();\n\t\t\t    var nomeTipo = $(\"#idTipo option[value='\"+idTipo+\"']\").text();\n\t\t\t    $(\"#nomeTipo\").val(nomeTipo);\n\t\t \t\t$.ajax({\n\t\t\t\t  url: \"/Catalogo/carregaFamilia.action\",\n\t\t\t\t  data:{\"ramoAtividade.idTipo\":$(this).val()},\n\t\t\t\t  context: document.body\n\t\t\t\t}).done(function(response) {\n\t\t\t\t\tvar options = \"\";\n\t\t                  options += '<option value=\"\">Selecione</option>';\n\t\t                  if (response != null) {\n\t\t                  \t$.each(response.listarFamilia, function (index, item) {\n\t\t                         options += '<option value=\"' + item.idFamilia + '\">' + item.idFamilia + ' - ' + item.familia + '</option>';\n\t\t                      });\n\t\t                  }\n\t\t                  $(\"#familia\").html(options);\n\t                      ordenarCombo(\"familia\");\n\t                      $(\"#familia\").val($(\"#familia option:first\").val());\n\t\t\t\t});\n\t\t    }\n\t\t});\n\t\t\t\t\t\t\t\t\t\t\n\t\t\n\t\t\t$(\"#familia\").change(function() {\n\t\t\t\t$('#classe')\n\t\t\t    .find('option').remove().end()\n\t\t\t    .append('<option value=\"\" selected=\"selected\">Selecione</option>').val('');\n\t\t\t$('#artigo')\n\t\t\t    .find('option').remove().end()\n\t\t\t    .append('<option value=\"\" selected=\"selected\">Selecione a Classe</option>').val('');\n\t\t\t\n\t\t\t\tif ($(this).val() != \"\") {\n\t\t\t\t\tvar parametros = \"ramoAtividade.idTipo=\"+$(\"#idTipo\").val();\n\t\t\t\t\tparametros += \"&ramoAtividade.idFamilia=\"+$(this).val();\n\t\t\t\t\tvar idFamilia = $(\"#familia\").val();\n\t\t\t\t\tvar nomeFamilia = $(\"#familia option[value='\"+ idFamilia + \"']\").text();\n\t\t\t\t\t$(\"#nomeFamilia\").val(nomeFamilia);\n\t\t\t\t\t$.ajax({\n\t\t\t\t\t\turl : \"carregaClasse.action\",\n\t\t\t\t\t\tdata : parametros,\n\t\t\t\t\t\tcontext : document.body\n\t\t\t\t\t}).done(function(response) {\n\t\t\t\t\t\tvar options = \"\";\n\t\t\t\t\t\toptions += '<option value=\"\">Selecione</option>';\n\t\t\t\t\t\tif (response != null) {\n\t\t\t\t\t\t\t$.each(response.listarClasse,function(index,item) {\n\t\t\t\t\t\t\t\toptions += '<option value=\"' + item.idClasse + '\">'+ item.idClasse + ' - ' + item.classe+ '</option>';\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t\t$(\"#classe\").html(options);\n\t                    ordenarCombo(\"classe\");\n\t                    $(\"#classe\").val($(\"#classe option:first\").val());\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t});\n\t\t\n\t\t\t$(\"#classe\").change(function() {\n\t\t\t\t$('#artigo')\n\t\t\t\t    .find('option').remove().end()\n\t\t\t\t    .append('<option value=\"\" selected=\"selected\">Selecione</option>').val('');\n\t\t\t\t\n\t\t\t\tif ($(this).val() != \"\") {\n\t\t\t\t\tvar parametros = \"ramoAtividade.idTipo=\"+$(\"#idTipo\").val();\n\t\t\t\t\tparametros += \"&ramoAtividade.idFamilia=\"+$(\"#familia\").val();\n\t\t\t\t\tparametros += \"&ramoAtividade.idClasse=\"+$(this).val();\n\t\t\t\t\tvar idClasse = $(\"#classe\").val();\n\t\t\t\t\tvar nomeClasse = $(\"option[value='\"+ idClasse + \"']\").text();\n\t\t\t\t\t$(\"#nomeClasse\").val(nomeClasse);\n\t\t\t\t\t$.ajax({\n\t\t\t\t\t\turl : \"carregaArtigo.action\",\n\t\t\t\t\t\tdata : parametros,\n\t\t\t\t\t\tcontext : document.body\n\t\t\t\t\t}).done(function(response) {\n\t\t\t\t\t\tvar options = \"\";\n\t\t\t\t\t\toptions += '<option value=\"\">Selecione</option>';\n\t\t\t\t\t\tif (response != null) {\n\t\t\t\t\t\t\t$.each(response.listarArtigo,function(index,item) {\n\t\t\t\t\t\t\t\toptions += '<option value=\"' + item.idArtigo + '\">'+ item.idArtigo + ' - ' + item.artigo + '</option>';\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t\t$(\"#artigo\").html(options);\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t});\n\t\n\t\t\t$(\"#artigo\").change(function() {\n\t\t\t\tvar idArtigo = $(\"#artigo\").val();\n\t\t\t\tvar nomeArtigo = $(\"option[value='\" + idArtigo+ \"']\").text();\n\t\t\t\t$(\"#nomeArtigo\").val(nomeArtigo);\n\t\t\t});\n\t\t\t\n\t\t\t$(\"#pesquisar\").click(callback);\n\t\t\t\n\t\t\tfunction callback() {\n\t\t\t\t$(\"#msgWarning2\").hide();\n\t\t\t\t$(\"#msgDanger2\").hide();\n\t\t\t\t$(\"#msgError\").hide();\n\t\t\t\tvar parametros = $(\"#buscarCatalogoRamoAtiv\").serialize();\n\t\t\t\tif(validateForm() == \"2\") {\t\t\t\t\t  \n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher ao menos um campo.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"3\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher os campos Família - Classe - Artigo.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"4\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher os campos Classe - Artigo.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"5\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher o campo Artigo.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t}  else if(validateForm() == \"6\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher o primeiro campo Termo do Item.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"7\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher o segundo campo Termo do Item.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"8\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor preencher o terceiro campo Termo do Item.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"9\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Favor selecionar uma opção no primeiro campo Tipo de Pesquisa.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else if(validateForm() == \"10\") {\n\t\t\t\t\t  $(\"#msgDanger2 .texto\").html(\"Não é possível adicionar mais uma linha no Tipo de Pesquisa sem preencher as anteriores.\");\n\t\t\t\t\t  $(\"#msgDanger2\").show();\n\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t  \t} else {\n\t\t\t\t\t$.ajax({\n\t\t\t\t\t  url: \"/Catalogo/countCatalogoEncontradosSorl.action\",\n\t\t\t\t\t  data:parametros,\n\t\t\t\t\t  method:\"POST\"\n\t\t\t\t\t}).done(function(response) {\t\t\t\t\t  \n\t\t\t\t\t\t  if(response.errorSolr != null) {\n\t\t\t\t\t\t\t  $(\"#msgWarning2 .texto\").html(response.errorSolr);\n\t\t\t\t\t\t\t  $(\"#msgWarning2\").show();\n\t\t\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t\t\t\t  }else{\n\t\t\t\t\t\t\t  if(response.countResultadosEncontrados <= 0) {\n\t\t\t\t\t\t\t\t  $(\"#msgWarning2 .texto\").html(\"Nenhum resultado foi encontrado.\");\n\t\t\t\t\t\t\t\t  $(\"#msgWarning2\").show();\n\t\t\t\t\t\t\t\t  $(\"html, body\").animate({scrollTop: '0px'}, 600);\n\t\t\t\t\t\t\t  }\telse {\n\t\t\t\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv\").attr(\"action\",\"/Catalogo/listar.action\");\n\t\t\t\t\t\t\t    \t$(\"#buscarCatalogoRamoAtiv\").submit(); \t  \n\t\t\t\t\t\t\t  }\t\t  \n\t\t\t\t\t\t  }\t\t\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t};\n\t\t\t\n\t\t\t\n\t\t\tfunction validateForm() {\n\t\t\t\t/*if(typeof $(\"#tipoPesquisa_2\").val() != \"undefined\") {\n\t\t\t\t\tif($(\"#termoPesquisaItem_1\").val() == \"\") {\n\t\t\t\t\t\tif($(\"#termoPesquisaItem_2\").val() != \"\") {\n\t\t\t\t\t\t\treturn \"10\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(typeof $(\"#tipoPesquisa_3\").val() != \"undefined\") {\n\t\t\t\t\tif($(\"#termoPesquisaItem_1\").val() == \"\" || $(\"#termoPesquisaItem_2\").val() == \"\") {\n\t\t\t\t\t\tif($(\"#termoPesquisaItem_3\").val() != \"\") {\n\t\t\t\t\t\t\treturn \"10\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}*/\n\t\t\t\t\n\t\t\t\tif (\t\n\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv #idTipo\").val().length + \n\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv #familia\").val().length + \n\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv #classe\").val().length + \n\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv #artigo\").val().length + \n\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv #tipoPesquisa_1\").val().length + \n\t\t\t\t\t\t$(\"#buscarCatalogoRamoAtiv #termoPesquisaItem_1\").val().length == 0 &&\n\t\t\t\t\t    $(\"#sustentavel\").val() == \"\") {\n\t\t            return 2;\n\t\t        }\n\t\t\t\tif($(\"#idTipo\").val() != \"\" && ($(\"#familia\").val() == \"\")) {\n\t\t\t\t\treturn \"3\";\n\t\t\t\t}\n\t\t\t\tif($(\"#idTipo\").val() != \"\" && $(\"#familia\").val() != \"\" && ($(\"#classe\").val() == \"\")) {\n\t\t\t\t\treturn \"4\";\n\t\t\t\t}\n\t\t\t\tif($(\"#idTipo\").val() != \"\" && $(\"#familia\").val() != \"\" && $(\"#classe\").val() != \"\" && ($(\"#artigo\").val() == \"\")) {\n\t\t\t\t\treturn \"5\";\n\t\t\t\t}if($(\"#tipoPesquisa_1\").val() != \"\" && $(\"#termoPesquisaItem_1\").val() == \"\") {\n\t\t\t\t\treturn \"6\";\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tvar counter = 0;\n\t\t\t\t$(\".show\").each(function(){\n\t\t\t       counter++;\n\t\t\t    });\n\t\t\t\tif(counter ==1){\n\t\t\t\t\tif(typeof $(\"#tipoPesquisa_2\").val() != \"undefined\") {\n\t\t\t\t\t\tif($(\"#tipoPesquisa_2\").val() != \"\" && $(\"#termoPesquisaItem_2\").val() == \"\") {\n\t\t\t\t\t\t\treturn \"7\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}else if(counter == 2){\n\t\t\t\t\tif(typeof $(\"#tipoPesquisa_2\").val() != \"undefined\") {\n\t\t\t\t\t\tif($(\"#tipoPesquisa_2\").val() != \"\" && $(\"#termoPesquisaItem_2\").val() == \"\") {\n\t\t\t\t\t\t\treturn \"7\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\tif(typeof $(\"#tipoPesquisa_3\").val() != \"undefined\") {\n\t\t\t\t\t\tif($(\"#tipoPesquisa_3\").val() != \"\" && $(\"#termoPesquisaItem_3\").val() == \"\") {\n\t\t\t\t\t\t\treturn \"8\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tif($(\"#tipoPesquisa_1\").val() == \"\" && $(\"#termoPesquisaItem_1\").val() != \"\") {\n\t\t\t\t\treturn \"9\";\n\t\t\t\t}\n\t\t\t\t\n\t\t\t}\n\n\t\t});\n\t\t\n// \t\tfunction removeLinhas(valor) {\n// \t\t\tif(valor == 3){\n// \t\t\t\t$(\"#condicao_3 option[value ='and']\").prop('selected', true)\n// \t\t\t\t$(\"#tipoPesquisa_3 option[value ='artigo']\").prop('selected', true)\n// \t\t\t\t$(\"#campoPesquisa_3 option[value ='igual']\").prop('selected', true)\n// \t\t\t\t$(\"#termoPesquisaItem_3\").val(\"\")\n// \t\t\t\t$(\"#linha3\").attr(\"class\", \"hide\");\n// \t\t\t\t$(linha3).hide();\n// \t\t\t}else{\n// \t\t\t\tvar counter = 0;\n// \t\t        $(\".show\").each(function(){\n// \t\t            counter++;\n// \t\t        });\n// \t\t\t\tif(counter == 1){\n// \t\t\t\t\t$(\"#condicao_2 option[value ='and']\").prop('selected', true)\n// \t\t\t\t\t$(\"#tipoPesquisa_2 option[value ='artigo']\").prop('selected', true)\n// \t\t\t\t\t$(\"#campoPesquisa_2 option[value ='igual']\").prop('selected', true)\n// \t\t\t\t\t$(\"#termoPesquisaItem_2\").val(\"\")\n// \t\t\t\t\t$(\"#linha2\").attr(\"class\", \"hide\");\n// \t\t\t\t\t$(linha2).hide();\n// \t\t\t\t}else{\n// \t\t\t\t\tvar valorCond = $('#condicao_2 option:selected').val()\n// \t\t\t\t\t$('#condicao_2 option[value =\"'+valorCond+'\"]').prop('selected', true)\n\t\t\t\t\t\n// \t\t\t\t\tvar valorTipo = $('#tipoPesquisa_3 option:selected').val()\n// \t\t\t\t\t$('#tipoPesquisa_2 option[value =\"'+valorTipo+'\"]').prop('selected', true)\n\t\t\t\t\t\n// \t\t\t\t\tvar valorCP = $('#campoPesquisa_3 option:selected').val()\n// \t\t\t\t\t$('#campoPesquisa_2 option[value =\"'+valorCP+'\"]').prop('selected', true)\n\t\t\t\t\t\n// \t\t\t\t\t$(\"#termoPesquisaItem_2\").val($(\"#termoPesquisaItem_3\").val())\n// \t\t\t\t\t$(\"#linha3\").attr(\"class\", \"hide\");\n// \t\t\t\t\t$(linha3).hide();\n// \t\t\t\t}\n// \t\t\t}\n// \t\t\t$('#addrowCatalogo').attr('disabled', false).html(\"<i class='material-icons icon-major'>&#xE03B;</i> Adicionar Linha\");\n// \t\t\treturn false;\n// \t\t};\n\t\t\n\t</script>\n\n\t\t\n\n<div id=\"alerts\">\n    \n    <!-- \t\t<div id=\"msgSuccess\" class=\"alert alert-success\" role=\"alert\"> -->\n    <!-- \t\t\t<a href=\"#\" class=\"close\" data-dismiss=\"alert\">&times;</a> -->\n    \n    \n    \n    \n    \n    <!-- \t    </div> -->\n    \n    \n    <!-- \t\t<div id=\"msgError\" class=\"alert alert-danger2\" role=\"alert\"> -->\n    <!-- \t\t\t<a href=\"#\" class=\"close\" data-dismiss=\"alert\">&times;</a> -->\n    \n    \n    \n    \n    \n    <!-- \t\t</div> -->\n    \n\n    <div id=\"msgWarning2\" class=\"alert alert-warning2\" role=\"alert\" style=\"display:none;\">\n        <a id=\"close\" href=\"#\" class=\"close\">&times;</a>\n        <span class=\"texto\">\n\t\t\t\n\t\t</span>\n    </div>\n\n    <div id=\"msgDanger2\" class=\"alert alert-danger2\" role=\"alert\" style=\"display:none;\">\n        <a href=\"#\" class=\"close\">&times;</a>\n        <span class=\"texto\">\n\t\t\t\n\t\t</span>\n    </div>\n</div>\n\t\t<div class=\"content\">\n\t\t\t<div id=\"content\" class=\"col-lg-offset-1 col-xs-12 col-sm-10 col-md-10 col-lg-9\"\n\t\t\t\trole=\"main\">\n\n\t\t\t\t<ol class=\"breadcrumb\">\n\t\t\t\t\t<li><a href=\"/index.action\"><i class=\"material-icons md\">&#xE88A;</i></a></li>\n\t\t\t\t\t<li><a href=\"/index.action\">Materiais e Serviços</a></li>\n\t\t\t\t\t<li><a href=\"/Catalogo/buscar.action\">Catálogo</a></li>\n\t\t\t\t</ol>\n\n\t\t\t\t<a href=\"#irconteudo\" class=\"sr-only\" id=\"irconteudo\"\n\t\t\t\t\tname=\"irconteudo\" accesskey=\"1\">Início do conteúdo</a>\n\t\t\t\t<h3>Pesquisar Itens Catalogados</h3>\n\t\t\t\t<!--// informações para impressão -->\n\t\t\t\t<div class=\"info-print\" style=\"display: none\">\n\t\t\t\t\t\n\t\t\t\t\t<span><strong>Data: </strong>09/09/2026</span>&nbsp;&nbsp;&nbsp;\t\t\t\t\t  \n\t\t\t\t\t<span><strong>Hora Consulta: </strong>13:17</span> \n\t\t\t\t</div>\t\t\t\t\n\t\t\t\t<!--// END: informações para impressão -->\n\n\t\t\t\t<div class=\"panel panel-default\">\n\t\t\t\t\t<form class=\"form-group panel-body\" action=\"#\" id=\"buscarCatalogoRamoAtiv\" method=\"post\">\n\n\t\t\t\t\t\t<tr style=\"display:none;\">\n  <td colspan=\"2\">\n<input type=\"hidden\" name=\"filtro.tipo\" value=\"\" id=\"nomeTipo\"/>  </td>\n</tr>\n\n\t\t\t\t\t\t<tr style=\"display:none;\">\n  <td colspan=\"2\">\n<input type=\"hidden\" name=\"filtro.familia\" value=\"\" id=\"nomeFamilia\"/>  </td>\n</tr>\n\n\t\t\t\t\t\t<tr style=\"display:none;\">\n  <td colspan=\"2\">\n<input type=\"hidden\" name=\"filtro.classe\" value=\"\" id=\"nomeClasse\"/>  </td>\n</tr>\n\n\t\t\t\t\t\t<tr style=\"display:none;\">\n  <td colspan=\"2\">\n<input type=\"hidden\" name=\"filtro.artigo\" value=\"\" id=\"nomeArtigo\"/>  </td>\n</tr>\n\n\n\n\n\t\t\t\t\t\t<section role=\"section\" class=\"documentacao\">\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div class=\"col-md-12\">\n\t\t\t\t\t\t\t\t\t<h5>Por Item</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"input-group\">\n\t\t\t\t\t\t\t\t\t\t<label for=\"selecao\">Tipo:\n\t\t\t\t\t\t\t\t\t\t</label>\n\n\t\t\t\t\t\t\t\t\t\t<div class=\"alert alert-warning alert-sm\" role=\"alert\">\n\t\t\t\t\t\t\t\t\t\t\t<i class=\"material-icons md first\">&#xE000;</i> Mensagem de\n\t\t\t\t\t\t\t\t\t\t\terro\n\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t<select class=\"form-control\" name=\"filtro.idTipo\" id=\"idTipo\">\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">Selecione</option>\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"1\">1 - MATERIAL</option>\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"2\">2 - SERVICOS</option>\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\n\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"input-group\">\n\t\t\t\t\t\t\t\t\t\t<label for=\"selecao\">Família: </label>\n\n\t\t\t\t\t\t\t\t\t\t<div class=\"alert alert-warning alert-sm\" role=\"alert\">\n\t\t\t\t\t\t\t\t\t\t\t<i class=\"material-icons md first\">&#xE000;</i> Mensagem de\terro\n\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t<select class=\"form-control\" name=\"filtro.idFamilia\" id=\"familia\" >\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">Selecione o Tipo</option>\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"input-group\">\n\t\t\t\t\t\t\t\t\t\t<label for=\"selecao\">Classe: </label>\n\t\t\t\t\t\t\t\t\t\t<div class=\"alert alert-warning alert-sm\" role=\"alert\">\n\t\t\t\t\t\t\t\t\t\t\t<i class=\"material-icons md first\">&#xE000;</i> Mensagem de erro\n\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t<select class=\"form-control\" name=\"filtro.idClasse\" id=\"classe\">\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">Selecione a Família</option>\n\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"input-group\">\n\t\t\t\t\t\t\t\t\t\t<label for=\"selecao\">Artigo: </label>\n\t\t\t\t\t\t\t\t\t\t<div class=\"alert alert-warning alert-sm\" role=\"alert\">\n\t\t\t\t\t\t\t\t\t\t\t<i class=\"material-icons md first\">&#xE000;</i> Mensagem de\terro\n\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t<select class=\"form-control\" name=\"filtro.idArtigo\" id=\"artigo\">\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">Selecione a Classe</option>\n\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<!-- Filtro de pesquisa -->\n\t\t\t\t\t\t\t\t\n\n\n\n\n\n\t<script type=\"text/javascript\">\n\t\t$(document).ready(function() {\n\t\t\t\n\t\t\t$(\"#addLinhas\").click(function() {\n\t\t        var counter = 0;\n\t\t        $(\".show\").each(function(){\n\t\t            counter++;\n\t\t        });\n\t\t        if(counter == 1){\n\t\t        \t$(\"#linha3\").attr(\"class\", \"show\");\n\t\t        \t$(linha3).show();\n\t\t        }else{\n\t\t        \t$(\"#linha2\").attr(\"class\", \"show\");\n\t\t        \t$(linha2).show();\n\t\t        }\n\t\t        if (counter == 1){\n\t\t            $('#addrowCatalogo').attr('disabled', true).html(\"<i class='material-icons'>&#xE14B;</i> Limite alcançado\");\n\t\t        }\n\t\t        return false;\n\t\t    });\n\t\t\t\n\t\t\t$(\"#removeLinha2\").click(function() {\n\t\t\t\tremoveLinhas($(this).val())\n\t\t\t\treturn false;\n\t\t\t});\n\t\t\t\n\t\t\t$(\"#removeLinha3\").click(function() {\n\t\t\t\tremoveLinhas($(this).val())\n\t\t\t\treturn false;\n\t\t\t});\n\t\t});\n\t\t\n\t\tfunction removeLinhas(valor) {\n\t\t\tif(valor == 3){\n\t\t\t\t$(\"#condicao_3 option[value ='and']\").prop('selected', true)\n\t\t\t\t$(\"#tipoPesquisa_3 option[value ='artigo']\").prop('selected', true)\n\t\t\t\t$(\"#campoPesquisa_3 option[value ='igual']\").prop('selected', true)\n\t\t\t\t$(\"#termoPesquisaItem_3\").val(\"\")\n\t\t\t\t$(\"#linha3\").attr(\"class\", \"hide\");\n\t\t\t\t$(linha3).hide();\n\t\t\t}else{\n\t\t\t\tvar counter = 0;\n\t\t        $(\".show\").each(function(){\n\t\t            counter++;\n\t\t        });\n\t\t\t\tif(counter == 1){\n\t\t\t\t\t$(\"#condicao_2 option[value ='and']\").prop('selected', true)\n\t\t\t\t\t$(\"#tipoPesquisa_2 option[value ='artigo']\").prop('selected', true)\n\t\t\t\t\t$(\"#campoPesquisa_2 option[value ='igual']\").prop('selected', true)\n\t\t\t\t\t$(\"#termoPesquisaItem_2\").val(\"\")\n\t\t\t\t\t$(\"#linha2\").attr(\"class\", \"hide\");\n\t\t\t\t\t$(linha2).hide();\n\t\t\t\t}else{\n\t\t\t\t\tvar valorCond = $('#condicao_2 option:selected').val()\n\t\t\t\t\t$('#condicao_2 option[value =\"'+valorCond+'\"]').prop('selected', true)\n\t\t\t\t\t\n\t\t\t\t\tvar valorTipo = $('#tipoPesquisa_3 option:selected').val()\n\t\t\t\t\t$('#tipoPesquisa_2 option[value =\"'+valorTipo+'\"]').prop('selected', true)\n\t\t\t\t\t\n\t\t\t\t\tvar valorCP = $('#campoPesquisa_3 option:selected').val()\n\t\t\t\t\t$('#campoPesquisa_2 option[value =\"'+valorCP+'\"]').prop('selected', true)\n\t\t\t\t\t\n\t\t\t\t\t$(\"#termoPesquisaItem_2\").val($(\"#termoPesquisaItem_3\").val())\n\t\t\t\t\t$(\"#linha3\").attr(\"class\", \"hide\");\n\t\t\t\t\t$(linha3).hide();\n\t\t\t\t}\n\t\t\t}\n\t\t\t$('#addrowCatalogo').attr('disabled', false).html(\"<i class='m