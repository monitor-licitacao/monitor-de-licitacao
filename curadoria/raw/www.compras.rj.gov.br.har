          "cookies": [],
          "content": {
            "size": 2545,
            "mimeType": "application/javascript",
            "text": "/*\n * Helper de máscara CPF/CNPJ adaptado ao CNPJ alfanumérico (IN RFB 2.229/2024).\n * Uso: aplicarMascaraCpfCnpj(\"#meuInput\")\n *  - Detecta CPF ou CNPJ pelo conteúdo (letra ou >11 chars limpos → CNPJ).\n *  - Formata em tempo real via evento 'input', sem usar o jQuery Mask Plugin.\n */\nfunction aplicarMascaraCpfCnpj(seletor) {\n    try {\n        $(seletor).unmask();\n    } catch (e) {\n    }\n\n    $(seletor).on('input', function () {\n        let inputValor = $(this).val().replace(/[^A-Za-z0-9]/g, '').toUpperCase();\n        if (inputValor.length > 14) {\n            inputValor = inputValor.substring(0, 14);\n        }\n\n        let formatado = '';\n        const temLetra = /[A-Za-z]/.test(inputValor);\n\n        if (temLetra || inputValor.length > 11) {\n            let digitoVerificador = '';\n            if (inputValor.length > 12) {\n                digitoVerificador = inputValor.substring(12).replace(/[^0-9]/g, '');\n            }\n            const parteAlfanumerica = inputValor.substring(0, 12);\n\n            if (parteAlfanumerica.length <= 2) {\n                formatado = parteAlfanumerica;\n            } else if (parteAlfanumerica.length <= 5) {\n                formatado = parteAlfanumerica.substring(0, 2) + '.' + parteAlfanumerica.substring(2);\n            } else if (parteAlfanumerica.length <= 8) {\n                formatado = parteAlfanumerica.substring(0, 2) + '.' + parteAlfanumerica.substring(2, 5) + '.' + parteAlfanumerica.substring(5);\n            } else {\n                formatado = parteAlfanumerica.substring(0, 2) + '.' + parteAlfanumerica.substring(2, 5) + '.' + parteAlfanumerica.substring(5, 8) + '/' + parteAlfanumerica.substring(8);\n            }\n\n            if (digitoVerificador.length > 0) {\n                formatado += '-' + digitoVerificador;\n            }\n        } else {\n            //CPF caso o de cima não seja atendido\n            const numeric = inputValor.replace(/[^0-9]/g, '');\n            if (numeric.length <= 3) {\n                formatado = numeric;\n            } else if (numeric.length <= 6) {\n                formatado = numeric.substring(0, 3) + '.' + numeric.substring(3);\n            } else if (numeric.length <= 9) {\n                formatado = numeric.substring(0, 3) + '.' + numeric.substring(3, 6) + '.' + numeric.substring(6);\n            } else {\n                formatado = numeric.substring(0, 3) + '.' + numeric.substring(3, 6) + '.' + numeric.substring(6, 9) + '-' + numeric.substring(9);\n            }\n        }\n\n        $(this).val(formatado);\n    }).trigger('input');\n}\n"
          },
