# Slack — App Config > Basic Information > App Credentials
SLACK_SIGNING_SECRET=coloque_aqui_o_signing_secret

# Slack — App Config > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-coloque-aqui-o-bot-token

# Notion — https://www.notion.so/my-integrations (Internal Integration Secret)
NOTION_API_KEY=secret_coloque_aqui_a_chave_do_notion

# Notion — ID do banco de dados onde as tarefas serão criadas
# (copie da URL da página do banco de dados, os 32 caracteres antes de "?v=")
NOTION_DATABASE_ID=coloque_aqui_o_database_id

# Amplitude — Configurações do Projeto > API Key
# Se preenchido, tem prioridade sobre TELEMETRY_WEBHOOK_URL.
AMPLITUDE_API_KEY=

# Alternativa genérica ao Amplitude: qualquer endpoint que aceite POST JSON
# (ex.: webhook do n8n/Zapier/Make). Usado apenas se AMPLITUDE_API_KEY estiver vazio.
TELEMETRY_WEBHOOK_URL=

# Porta local do servidor HTTP do Bolt (usada também pelo ngrok)
PORT=3000
