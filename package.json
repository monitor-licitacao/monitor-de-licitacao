{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "preinstall": "node -e \"if (process.versions.bun || String(process.env.npm_execpath || '').includes('bun')) { console.error('Use npm ci - este repo nao aceita bun install.'); process.exit(1) }\"",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test server/lib/allowedOutboundUrl.test.ts __amplitude_verify__.test.ts __pncp_client__.test.ts __pncp_search__.test.ts __contratacoes_enrichment__.test.ts __contratacao_itens__.test.ts __mural_v1__.test.ts __mural_frontend_ui__.test.ts __compras_gov_open_data__.test.ts __passex_golden__.test.ts __compras_gov_enrich__.test.ts __source_http_audit__.test.ts __pncp_domains__.test.ts __pncp_domain_links__.test.ts __price_cross__.test.ts __pncp_resultados__.test.ts __parse_pncp_facets__.test.ts __pncp_arquivos__.test.ts __contratos_health__.test.ts __contratos_vigencia_policy__.test.ts __contratos_manual__.test.ts __contratos_manual_v2__.test.ts __contratos_pncp_sync__.test.ts __contratos_reajuste__.test.ts __contratos_unidades__.test.ts __pipeline_status__.test.ts __pipeline_kpis__.test.ts __pipeline_persist__.test.ts __pipeline_import__.test.ts",
    "audit:sources": "node --import tsx scripts/source_http_audit.ts",
    "compras-gov:compare-golden": "node --import tsx scripts/compras_gov_compare_golden.ts",
    "auth:reset-password": "node --import tsx scripts/reset-user-password.ts",
    "seed:status-catalog": "node --import tsx scripts/seed-status-catalog.ts",
    "check-health": "bash ./scripts/check-health.sh",
    "commit": "npx git-cz",
    "push-safe": "npm run check-health && git push origin $(git branch --show-current)",
    "auto-ship": "bash ./scripts/auto-ship.sh",
    "prepare": "node -e \"try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "worker:pncp": "tsx server/workers/pncp_collector.ts",
    "worker:sescsp": "tsx server/workers/scraper_puppeteer_sesc.ts",
    "worker:compras-gov": "tsx server/workers/compras_gov_enrich.ts",
    "worker:pncp-discover": "tsx server/workers/pncp_discover.ts",
    "worker:pncp-contratos": "tsx server/workers/pncp_contratos.ts",
    "worker:pncp-domains": "tsx server/workers/pncp_domains.ts",
    "compras-gov:enrich-fixture": "node --import tsx scripts/compras_gov_enrich_fixture.ts",
    "pncp:discover-fixture": "node --import tsx scripts/pncp_discover_fixture.ts",
    "pncp:ingest-resultados": "node --import tsx scripts/pncp_ingest_resultados.ts",
    "pncp:backfill-facets": "node --import tsx scripts/pncp_backfill_facets.ts",
    "pncp:sync-documentos": "node --import tsx scripts/pncp_sync_documentos.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/xai": "^4.0.54",
    "@amplitude/ai": "^0.16.0",
    "@amplitude/unified": "^1.1.32",
    "@google/genai": "^2.4.0",
    "@neon/env": "^1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^7.0.92",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "puppeteer": "^25.10.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.10.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@neon/config": "^1.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
