{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test __amplitude_verify__.test.ts __mural_v1__.test.ts __mural_frontend_ui__.test.ts",
    "check-health": "bash ./scripts/check-health.sh",
    "commit": "npx git-cz",
    "push-safe": "npm run check-health && git push origin $(git branch --show-current)",
    "auto-ship": "bash ./scripts/auto-ship.sh",
    "prepare": "node -e \"try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "worker:pncp": "tsx server/workers/pncp_collector.ts",
    "worker:sescsp": "tsx server/workers/scraper_puppeteer_sesc.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/xai": "^4.0.54",
    "@amplitude/ai": "^0.16.0",
    "@amplitude/unified": "^1.1.32",
    "@google/genai": "^2.4.0",
    "@neon/env": "^1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^7.0.92",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "puppeteer": "^25.10.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.10.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@neon/config": "^1.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
